# ── Tidemark local environment (gitignored) ───────────────────────────────
# Supabase project ref goes in scripts/db-push.sh
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# >>> FILL IN: Dashboard → Project Settings → API Keys → "Secret keys" (sb_secret_...)
SUPABASE_SECRET_KEY=
# >>> FILL IN: the database password you chose when creating the project
SUPABASE_DB_PASSWORD=
# LLM: OpenRouter (default) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_RESEARCH_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Or Claude instead: set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# Generate: TIDEMARK_ENCRYPTION_KEY=$(openssl rand -base64 32)  CRON_SECRET=$(openssl rand -hex 32)
TIDEMARK_ENCRYPTION_KEY=
CRON_SECRET=

# Optional: model override (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Optional data sources ─────────────────────────────────────────────────
# Latest FOIA CSV links from https://data.sba.gov/dataset/7-a-504-foia
SBA_504_CSV_URL=
SBA_7A_CSV_URL=
# Comma-separated trade-press RSS feeds (headlines + links only; check each publisher's terms)
PRESS_RSS_FEEDS=https://www.areadevelopment.com/rss/NewsItems.xml?t=2
# Knowledge-base embeddings (optional; full-text search works without)
VOYAGE_API_KEY=

# ── Optional contact providers (licensed data) ────────────────────────────
APOLLO_API_KEY=
PDL_API_KEY=
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=

# ── Integrations (OAuth apps you register) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
ATTIO_CLIENT_ID=
ATTIO_CLIENT_SECRET=

# ── Dev only: one-click login button on /login (ignored in production builds)
DEV_LOGIN_ENABLED=false
DEV_LOGIN_EMAIL=you@example.com
# Dev only: fake integration providers for testing flows (ignored in production builds)
INTEGRATIONS_SANDBOX=false
